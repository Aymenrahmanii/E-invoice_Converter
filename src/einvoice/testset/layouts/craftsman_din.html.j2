{% from "_macros.j2" import ref_label, vat_lines %}
<html lang="de"><head><meta charset="utf-8"><style>{{ css | safe }}
.letterhead { text-align: right; border-bottom: 2pt solid #8a3b12; padding-bottom: 3mm; }
.letterhead h1 { margin: 0; font-size: 17pt; color: #8a3b12; }
.addr { display: flex; justify-content: space-between; margin-top: 12mm; height: 42mm; }
.window { width: 85mm; }
.sender-line { font-size: 7pt; text-decoration: underline; margin-bottom: 2mm; }
.info { width: 72mm; }
.items th { border-bottom: 1pt solid #222; text-align: left; }
.items td { border-bottom: 0.4pt solid #ccc; }
.footer { margin-top: 12mm; font-size: 8pt; color: #555; border-top: 0.5pt solid #999; padding-top: 2mm; }
</style></head><body>
<div class="letterhead"><h1>{{ inv.seller.name }}</h1>
<div class="small">Meisterbetrieb · {{ inv.seller.address.street }} · {{ inv.seller.address.postcode }} {{ inv.seller.address.city }}</div>
<div class="small">Tel. {{ inv.seller.contact.phone }} · {{ inv.seller.contact.email }}</div></div>
<div class="addr"><div class="window"><div class="sender-line">{{ inv.seller.name }}, {{ inv.seller.address.street }}, {{ inv.seller.address.postcode }} {{ inv.seller.address.city }}</div>
{{ inv.buyer.name }}<br>{{ inv.buyer.address.street }}<br>{{ inv.buyer.address.postcode }} {{ inv.buyer.address.city }}</div>
<table class="info small">
<tr><td>Rechnungsnummer:</td><td class="r">{{ inv.number }}</td></tr>
<tr><td>Rechnungsdatum:</td><td class="r">{{ fmt.date(inv.issue_date) }}</td></tr>
{% if inv.delivery_date %}<tr><td>Leistungsdatum:</td><td class="r">{{ fmt.date(inv.delivery_date) }}</td></tr>{% endif %}
<tr><td>{{ ref_label(leitweg) }}:</td><td class="r">{{ inv.buyer_reference }}</td></tr>
{% if inv.buyer.vat_id %}<tr><td>Ihre USt-IdNr.:</td><td class="r">{{ inv.buyer.vat_id }}</td></tr>{% endif %}
</table></div>
<h2>Rechnung Nr. {{ inv.number }}</h2>
<p>Sehr geehrte Damen und Herren,<br>für die ausgeführten Arbeiten erlauben wir uns, wie folgt zu berechnen:</p>
<table class="items"><thead><tr><th>Pos.</th><th>Leistung</th><th class="r">Menge</th><th>Einh.</th><th class="r">E-Preis</th><th class="r">Gesamt</th></tr></thead><tbody>
{% for l in inv.lines %}<tr><td>{{ l.line_id }}</td><td>{{ l.description }}{% if l.seller_item_id %}<br><span class="small muted">Art.-Nr. {{ l.seller_item_id }}</span>{% endif %}</td><td class="r">{{ fmt.number(l.quantity) }}</td><td>{{ fmt.unit(l.unit_code) }}</td><td class="r nowrap">{{ fmt.money(l.unit_price) }}</td><td class="r nowrap">{{ fmt.money(l.net_amount) }}</td></tr>
{% endfor %}</tbody></table>
<table class="totals"><tr><td>Summe netto</td><td class="r">{{ fmt.money(inv.net_total) }}</td></tr>
{{ vat_lines(vat, fmt) }}
<tr class="grand"><td>Rechnungsbetrag</td><td class="r">{{ fmt.money(inv.gross_total) }}</td></tr></table>
<p>{{ inv.payment_terms }}{% if inv.due_date %} Fällig am {{ fmt.date(inv.due_date) }}.{% endif %}</p>
<p>Mit freundlichen Grüßen<br>{{ inv.seller.contact.name }}</p>
<div class="footer">{{ inv.seller.name }} · USt-IdNr. {{ inv.seller.vat_id }} · IBAN {{ inv.iban }}{% if inv.bic %} · BIC {{ inv.bic }}{% endif %}</div>
</body></html>
