{% from "_macros.j2" import ref_label, vat_lines %}
<html lang="de"><head><meta charset="utf-8"><style>{{ css | safe }}
body { font-size: 8pt; }
.head { display: flex; justify-content: space-between; border-bottom: 1.5pt solid #0a6e3a; padding-bottom: 2mm; }
.head h1 { color: #0a6e3a; margin: 0; font-size: 15pt; }
.boxes { display: flex; gap: 4mm; margin: 5mm 0; }
.box { border: 0.6pt solid #999; padding: 2mm; flex: 1; }
.items th { border: 0.5pt solid #777; background: #e9f3ed; font-size: 7.5pt; }
.items td { border: 0.4pt solid #bbb; padding: 1.5pt 3pt; }
</style></head><body>
<div class="head"><div><h1>{{ inv.seller.name }}</h1>Großhandel · {{ inv.seller.address.street }} · {{ inv.seller.address.postcode }} {{ inv.seller.address.city }}</div>
<div class="r">Tel.: {{ inv.seller.contact.phone }}<br>{{ inv.seller.contact.email }}<br>USt-IdNr.: {{ inv.seller.vat_id }}</div></div>
<div class="boxes">
<div class="box"><b>Rechnungsempfänger</b><br>{{ inv.buyer.name }}<br>{{ inv.buyer.address.street }}<br>{{ inv.buyer.address.postcode }} {{ inv.buyer.address.city }}</div>
<div class="box"><b>RECHNUNG</b><br>Beleg-Nr.: {{ inv.number }}<br>Belegdatum: {{ fmt.date(inv.issue_date) }}{% if inv.delivery_date %}<br>Lieferdatum: {{ fmt.date(inv.delivery_date) }}{% endif %}<br>{{ ref_label(leitweg) }}: {{ inv.buyer_reference }}{% if inv.buyer.vat_id %}<br>Kunden-USt-IdNr.: {{ inv.buyer.vat_id }}{% endif %}</div>
</div>
<table class="items"><thead><tr><th>Pos</th><th>Artikel-Nr.</th><th>Bezeichnung</th><th class="r">Menge</th><th>ME</th><th class="r">Preis/ME</th><th class="r">USt %</th><th class="r">Netto</th></tr></thead><tbody>
{% for l in inv.lines %}<tr><td class="c">{{ l.line_id }}</td><td>{{ l.seller_item_id or "" }}</td><td>{{ l.description }}</td><td class="r">{{ fmt.number(l.quantity) }}</td><td>{{ fmt.unit(l.unit_code) }}</td><td class="r nowrap">{{ fmt.money(l.unit_price) }}</td><td class="r">{{ fmt.number(l.vat_rate) }}</td><td class="r nowrap">{{ fmt.money(l.net_amount) }}</td></tr>
{% endfor %}</tbody></table>
<table class="totals"><tr><td>Warenwert netto</td><td class="r">{{ fmt.money(inv.net_total) }}</td></tr>
{{ vat_lines(vat, fmt) }}
<tr class="grand"><td>Endbetrag</td><td class="r">{{ fmt.money(inv.gross_total) }}</td></tr></table>
<p>{{ inv.payment_terms }}{% if inv.due_date %} Fälligkeit: {{ fmt.date(inv.due_date) }}{% endif %}<br>Bankverbindung: IBAN {{ inv.iban }}{% if inv.bic %}, BIC {{ inv.bic }}{% endif %}</p>
<p class="small muted">Es gelten unsere Allgemeinen Lieferbedingungen. Die Ware bleibt bis zur vollständigen Bezahlung unser Eigentum.</p>
</body></html>
